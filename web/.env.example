# Copy this file to  web/.env  and fill in your credentials to enable LIVE data.
# Without these the app runs in demo mode (the UI still works).

# DataForSEO (primary live engine) — sign up at https://dataforseo.com
# These are your API login (usually your email) and password from the dashboard.
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password

# Optional: SE Ranking Data API token (secondary). https://seranking.com
SERANKING_API_KEY=

# Optional: change the local port (default 8000)
PORT=8000
